<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Workplace Orchestrator" Width="1220" Height="820" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#4974DA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3265CD"/><Setter Property="BorderBrush" Value="#3265CD"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style><Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#14263D"><Grid Margin="22,28,22,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><Border Background="#2E527C" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left"><TextBlock Text="W" FontSize="23" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Workplace" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock Text="ORCHESTRATOR" Foreground="#9EB2CC" FontSize="10" Margin="1,5,0,30"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="WORKSPACES" Foreground="#8DA4BF" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,12"/><Button x:Name="NewWorkspace" Content="+  New workspace" Background="#213B59" BorderBrush="#36516E" Foreground="White" HorizontalContentAlignment="Left" Margin="0,0,0,16"/></StackPanel>
      <ListBox x:Name="WorkspaceList" Grid.Row="2" Foreground="White" HorizontalContentAlignment="Stretch">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#29486E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#567497"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#9FB4D0" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3"><Border Height="1" Background="#2D4059" Margin="0,12,0,18"/><Button x:Name="Preferences" Content="Preferences" Background="Transparent" BorderThickness="0" Foreground="#BDCCE0" Padding="0,8" HorizontalAlignment="Left"/><Button x:Name="Diagnostics" Content="System diagnostics" Background="Transparent" BorderThickness="0" Foreground="#BDCCE0" Padding="0,8" HorizontalAlignment="Left"/><Button x:Name="Privacy" Content="Privacy &amp; local data" Background="Transparent" BorderThickness="0" Foreground="#BDCCE0" Padding="0,8" HorizontalAlignment="Left"/><TextBlock Text="LOCAL ONLY   ·   v1.1.0" Foreground="#718BAA" FontSize="10" Margin="0,18,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="34,30,34,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="YOUR WORKSPACE" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#E4F1EB" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right"><TextBlock Text="●  On your device" Foreground="#327B64" FontSize="11"/></Border></DockPanel>
      <Grid Grid.Row="1" Margin="0,24,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WorkspaceTitle" Text="A calmer start to work." FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="WorkspaceSubtitle" Text="Your applications, ready in the right order." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel><Button x:Name="WorkspaceMenu" Grid.Column="1" Content="•••" VerticalAlignment="Top" Margin="12,3,0,0" ToolTip="Workspace settings, duplicate, or delete"/></Grid>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ModeTitle" Text="One workspace. Everything you need." FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ModeDescription" Text="Choose your apps and let them settle in, one at a time." Foreground="{DynamicResource MutedBrush}" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StopWorkspace" Content="Stop workspace"/><Button x:Name="LaunchWorkspace" Content="▶  Launch workspace" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Grid></Border>
      <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="AddApp" DockPanel.Dock="Right" Content="+  Add application" Margin="0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Applications" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Launch order · use the row menu to reorder or adjust timing" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
        <ListBox x:Name="AppList" Grid.Row="1" HorizontalContentAlignment="Stretch" Padding="0">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="{DynamicResource SubtleBrush}" CornerRadius="7" VerticalAlignment="Top"><Grid><TextBlock Text="▣" Foreground="#7D95B7" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image Source="{Binding Icon}" Width="24" Height="24"/></Grid></Border><StackPanel Grid.Column="1" Margin="12,0,16,0"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RuleLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColor}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding ActionLabel}" IsEnabled="{Binding ActionEnabled}" Tag="action" Padding="12,7"/><Button Content="•••" Tag="menu" Padding="9,7" Margin="0" ToolTip="Application settings and order"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="EmptyState" Grid.Row="1" Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="35" VerticalAlignment="Top" Margin="0,12,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Make room for focused work" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Create a workspace, then add the applications you use together." Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="Smart sequencing  ·  Live status  ·  Safe stopping" Foreground="{DynamicResource MutedBrush}" Margin="0,24,0,0" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" Text="Ready when you are" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Stop affects only applications opened by this workspace session." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Retry" Content="Retry" Visibility="Collapsed"/><Button x:Name="Skip" Content="Skip" Visibility="Collapsed"/><Button x:Name="Cancel" Content="Cancel sequence" Visibility="Collapsed" Margin="0"/></StackPanel></Grid></Border>
    </Grid>
  </Grid>
</Window>

